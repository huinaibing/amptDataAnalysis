# submit_condor.sh generates analysis.dag with the variables used below.
# Each DAG node runs one ROOT process, including the final merge node.
universe = vanilla
executable = condor_worker.sh
arguments = "$(mode) $(shard) $(result) $(expected) $(eos_output)"

should_transfer_files = YES
transfer_input_files = analysis.tar.gz, job_config.sh, merge_inputs.txt
# The worker uploads validated ROOT results; Condor always returns stdout/stderr.
transfer_output_files = ""
when_to_transfer_output = ON_EXIT
# DAGMan controls retries; do not also retry inside the schedd.
max_retries = 0

output = logs/$(mode)_$(shard).$(ClusterId).out
error = logs/$(mode)_$(shard).$(ClusterId).err
log = logs/$(mode)_$(shard).$(ClusterId).log
getenv = False
MY.WantOS = "el9"
requirements = (Arch == "X86_64")
+JobFlavour = "longlunch"

queue 1
